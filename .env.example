# Copy this file to .env and fill in real values.

# --- Accounts ---
# Comma-separated "username:password" pairs. Passwords may be plaintext or a
# bcrypt hash ($2a$ / $2b$ / $2y$). Usernames must match [A-Za-z0-9._-]{1,32}
# and are compared case-insensitively. Passwords must not contain a comma.
# bcrypt hashes contain "$", so wrap the whole value in single quotes:
#   USERS='alice:$2b$10$abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopq,bob:plainpassword'
USERS=

# Account that inherits clipboard/files created before multi-account support.
# Defaults to the first entry in USERS. Must be one of the configured usernames.
DEFAULT_ACCOUNT=

# --- Legacy single-account mode ---
# Only used when USERS is empty: creates a single account with this password,
# named DEFAULT_ACCOUNT (or "default" when that is unset).
SHARED_PASSWORD=

# --- Required ---
# Long random string. Empty or placeholder values are rejected at startup,
# because a guessable secret lets anyone forge a token for any account.
JWT_SECRET=

# --- Server ---
PORT=3000
DATABASE_URL=file:./prisma/dev.db
LOG_DIR=
IPINFO_API_KEY=
MAX_UPLOAD_SIZE_MB=200
